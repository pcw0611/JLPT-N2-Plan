  },
  {
    "start": 117.0,
    "end": 121.0,
    "text": "元もよいものは4番です。"
  },
  {
    "start": 121.0,
    "end": 127.0,
    "text": "回答用しの問題3の例のところを見てください。"
  },
  {
    "start": 127.0,
    "end": 131.0,
    "text": "元もよいものは4番ですから"
  },
  {
    "start": 131.0,
    "end": 136.0,
